{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm run dev -w @app/server\" \"npm run dev -w @app/web\"",
    "build": "npm run build -w @app/web && npm run build -w @app/server",
    "start": "node --enable-source-maps apps/server/dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "docker:app": "docker compose up --build",
    "docker:dev": "docker compose -f compose.dev.yaml up --build dev",
    "docker:test": "docker compose -f compose.dev.yaml run --rm --build test",
    "test:e2e": "playwright test",
    "docker:e2e": "docker compose -f compose.dev.yaml run --rm --build e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
