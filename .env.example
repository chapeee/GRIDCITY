PROJECT_NAME=GRIDCITY

# Optional settings (defaults shown)
# SERVER_PORT=4600
# WEB_PORT=4601
# LOG_LEVEL=info
# real = hosts from hosts.yaml over SSH; demo = simulated fleet (shows a DEMO DATA badge)
# DATA_MODE=real
# Override where hosts.yaml / the database live (defaults follow your OS conventions)
# CONFIG_DIR=
# DATA_DIR=

# AI agents (Ctrl+K -> "Ask an AI agent"). Only needed for API-key sign-in; Codex and
# Gemini CLI can also sign in with your ChatGPT / Google account when the app runs
# natively. Claude in the panel needs an API key; with a Claude subscription, connect
# Claude Code instead (the panel shows the command). Put real keys in .env, never here.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
