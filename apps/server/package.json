{
  "name": "@app/server",
  "version": "0.2.0",
  "private": true,
  "description": "Local-only backend: SSH connections, metrics polling, state engine and terminal streaming. Binds to 127.0.0.1.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts --dev",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "import-ssh-config": "tsx src/cli/import-ssh-config.ts",
    "add-host": "tsx src/cli/add-host.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.5.0",
    "@app/shared": "*",
    "@aws-sdk/client-cloudwatch": "^3.1165.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1166.0",
    "@aws-sdk/client-rds": "^3.1165.0",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-sqlite3": "^13.0.3",
    "bson": "^7.3.4",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "mongodb": "^7.8.0",
    "mssql": "^12.7.14",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "ssh2": "^1.17.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.23.1",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.2"
  }
}
