{
  "name": "@app/server",
  "version": "0.0.0",
  "private": true,
  "description": "Local-only backend: SSH connections, metrics polling, state engine and terminal streaming. Binds to 127.0.0.1.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts --dev",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "import-ssh-config": "tsx src/cli/import-ssh-config.ts"
  },
  "dependencies": {
    "@app/shared": "*",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "ssh2": "^1.17.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.2"
  }
}
